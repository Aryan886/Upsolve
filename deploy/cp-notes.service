[Unit]
Description=CP Notes website and API
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=cp-notes
Group=cp-notes
WorkingDirectory=/opt/cp-notes/current
EnvironmentFile=/etc/cp-notes/app.env
ExecStart=/opt/node/bin/node /opt/cp-notes/current/backend/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cp-notes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cp-notes

[Install]
WantedBy=multi-user.target
