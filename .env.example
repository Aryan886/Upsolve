# Copy to .env in the repository root for local development.
# Backend dev/admin scripts explicitly load ../.env. Vite reads public VITE_* values.
# Production systemd loads /etc/cp-notes/app.env; see deploy/README.md.
NODE_ENV=development
LOCAL_DEVELOPMENT=true
PORT=3000
APP_ORIGIN=http://localhost:5173
# Leave DATABASE_PATH unset to use backend/data/cp-notes.db regardless of working directory.
# DATABASE_PATH=/var/lib/cp-notes/cp-notes.db
# Find the actual development ID in chrome://extensions; no wildcard origins.
EXTENSION_ORIGINS=
SESSION_DAYS=30
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://localhost:3000/api
# VITE_FEEDBACK_URL=https://your-feedback-form
# Required for extension release builds (32 lowercase letters a-p):
# VITE_EXTENSION_ID=
# Optional public store manifest key, for a consistent unpacked ID:
# VITE_EXTENSION_KEY=
# VITE_EXTENSION_INSTALL_URL=https://chromewebstore.google.com/detail/your-item
# BACKUP_DIRECTORY=/var/lib/cp-notes/backups
# BACKUP_S3_URI=s3://your-private-bucket/daily
