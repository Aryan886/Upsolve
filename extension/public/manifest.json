{
  "manifest_version": 3,
  "name": "CP Notes",
  "version": "0.1.0",
  "description": "Capture competitive programming patterns, mistakes, snippets, and editorial takeaways.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Capture a CP note",
    "default_popup": "popup.html"
  }
}
